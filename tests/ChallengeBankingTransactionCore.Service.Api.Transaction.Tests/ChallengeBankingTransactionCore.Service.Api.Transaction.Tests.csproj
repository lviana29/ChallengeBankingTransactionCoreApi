<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="Testcontainers" Version="4.16.0" />
    <PackageReference Include="Testcontainers.MySql" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />

  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <None Update="appsettings.Test.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ChallengeBankingTransactionCore.Service.Api.Transaction\ChallengeBankingTransactionCore.Service.Api.Transaction.csproj" />
    <ProjectReference Include="..\..\src\ChallengeBankingTransactionCore.Service.Infrastructure.Transaction\ChallengeBankingTransactionCore.Service.Infrastructure.Transaction.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Outras propriedades existentes -->
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura,opencover,json</CoverletOutputFormat>
    <Exclude>[*.Tests]*,[xunit.*]*</Exclude>
    <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
    <ExcludeByFile>**/bin/**/*.cs,**/obj/**/*.cs,**/Program.cs,**/Configurations/*Swagger*.cs,**/Configurations/*Scalar*.cs,**/Configurations/*OpenAPI*.cs,**/Configurations/DataBaseConfig.cs,**/Configurations/EvolveConfig.cs,**/Configurations/LoggingConfig.cs</ExcludeByFile>
  </PropertyGroup>

</Project>
